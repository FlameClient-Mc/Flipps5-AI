# Flipps V0.1 — optional API keys
# Copy this file to ".env" and fill in your keys. ".env" is gitignored,
# so your keys never end up in the repo. Flipps picks them up automatically.
#
# Tip: one Google Cloud API key can power BOTH Google Search and YouTube
# (enable both APIs in the same project).

# --- Google Custom Search (real Google results) ---
# 1. https://console.cloud.google.com/apis/library/customsearch.googleapis.com  -> Enable
# 2. Credentials -> Create credentials -> API key   (this is GOOGLE_CSE_KEY)
# 3. https://programmablesearchengine.google.com/   -> create engine, search "entire web"
#    -> copy the Search engine ID                    (this is GOOGLE_CSE_CX)
GOOGLE_CSE_KEY=
GOOGLE_CSE_CX=

# --- YouTube Data API v3 ---
# https://console.cloud.google.com/apis/library/youtube.googleapis.com -> Enable
# Reuse the same API key from above, or create a new one.
YOUTUBE_API_KEY=

# --- GitHub (optional: higher rate limits; works without it) ---
# https://github.com/settings/tokens
GITHUB_TOKEN=

# --- Telegram (optional: send messages) ---
# Message @BotFather on Telegram -> /newbot -> copy the token
TELEGRAM_BOT_TOKEN=

# --- X/Twitter (paid API) and Instagram (business API) ---
X_API_BEARER=
INSTAGRAM_TOKEN=
